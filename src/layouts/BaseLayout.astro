---
import '../styles/tokens/fonts.css';
import '../styles/tokens/colors.css';
import '../styles/tokens/typography.css';
import '../styles/tokens/spacing.css';
import '../styles/tokens/effects.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { Locale } from '../i18n';
import { ADVISOR_NAMES } from '../i18n/advisors';
import { getCanonicalUrl, getAlternateLinks, getOgLocale, getOgImageUrl } from '../lib/seo';

export interface Props {
  locale: Locale;
  title: string;
  description: string;
  advisorRoles: { francisco: string; raimundo: string };
}

const { locale, title, description, advisorRoles } = Astro.props;
const canonicalUrl = getCanonicalUrl(locale);
const alternateLinks = getAlternateLinks();
const ogImageUrl = getOgImageUrl();

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'NB Advisory',
  url: canonicalUrl,
  member: [
    { '@type': 'Person', name: ADVISOR_NAMES.francisco, jobTitle: advisorRoles.francisco },
    { '@type': 'Person', name: ADVISOR_NAMES.raimundo, jobTitle: advisorRoles.raimundo },
  ],
};
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-32.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLinks.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={getOgLocale(locale)} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="nb-skip-link">Skip to content</a>
    <slot />
    <script data-astro-rerun is:inline>
      const revealEls = Array.from(document.querySelectorAll('.nb-reveal'));
      if (revealEls.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.setAttribute('data-shown', 'true');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        for (const el of revealEls) {
          el.classList.add('nb-reveal--armed');
          observer.observe(el);
        }
      }
    </script>
  </body>
</html>
