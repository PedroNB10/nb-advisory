---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Opening from '../../components/sections/Opening.astro';
import Recognition from '../../components/sections/Recognition.astro';
import Perspective from '../../components/sections/Perspective.astro';
import HowNbActs from '../../components/sections/HowNbActs.astro';
import Capabilities from '../../components/sections/Capabilities.astro';
import Advisors from '../../components/sections/Advisors.astro';
import Conversation from '../../components/sections/Conversation.astro';
import { getContent } from '../../i18n';

const locale = 'en' as const;
const content = getContent(locale);
---

<BaseLayout
  locale={locale}
  title="NB Advisory"
  description={content.hero.sub}
  advisorRoles={{
    francisco: content.advisors.franciscoRole,
    raimundo: content.advisors.raimundoRole,
  }}
>
  <Header locale={locale} nav={content.nav} />
  <main id="main" tabindex="-1">
    <Opening hero={content.hero} />
    <Recognition recognition={content.recognition} />
    <Perspective perspective={content.perspective} />
    <HowNbActs how={content.how} />
    <Capabilities capabilities={content.capabilities} />
    <Advisors advisors={content.advisors} />
    <Conversation cta={content.cta} />
  </main>
  <Footer footer={content.footer} />
</BaseLayout>
