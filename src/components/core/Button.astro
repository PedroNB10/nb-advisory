---
import type { HTMLAttributes } from 'astro/types';

export type ButtonVariant = 'primary' | 'secondary' | 'ghost';
export type ButtonSize = 'sm' | 'md' | 'lg';

interface ButtonStyleProps {
  variant?: ButtonVariant;
  size?: ButtonSize;
}

type AnchorProps = ButtonStyleProps & HTMLAttributes<'a'> & { as: 'a' };
type NativeButtonProps = ButtonStyleProps & HTMLAttributes<'button'> & { as?: 'button' };

export type Props = AnchorProps | NativeButtonProps;

const { as = 'button', variant = 'primary', size = 'lg', class: className, ...rest } = Astro.props;

const Tag = as;
---

<Tag class:list={['nb-button', `nb-button--${variant}`, `nb-button--${size}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  .nb-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
    white-space: nowrap;
  }

  .nb-button:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .nb-button:active {
    opacity: 0.9;
  }

  .nb-button--sm {
    min-height: 40px;
    padding: 0 var(--space-4);
  }

  .nb-button--md {
    min-height: 44px;
    padding: 0 var(--space-5);
  }

  .nb-button--lg {
    min-height: 54px;
    padding: 0 var(--space-6);
  }

  .nb-button--primary {
    background: transparent;
    border: 1px solid var(--nb-gold-500);
    color: var(--nb-gold-300);
  }

  .nb-button--secondary {
    background: transparent;
    border: 1px solid var(--color-border-on-dark-subtle);
    color: var(--nb-silver-300);
  }

  .nb-button--ghost {
    background: transparent;
    border: 1px solid transparent;
    color: var(--nb-silver-500);
  }

  @media (hover: hover) {
    .nb-button--primary:hover {
      background: var(--nb-gold-500);
      color: var(--nb-navy-950);
    }

    .nb-button--secondary:hover {
      border-color: var(--nb-silver-300);
      color: var(--nb-silver-100);
    }

    .nb-button--ghost:hover {
      color: var(--nb-silver-100);
    }
  }
</style>
