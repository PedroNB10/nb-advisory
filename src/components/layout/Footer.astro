---
import type { FooterContent } from '../../i18n';

export interface Props {
  footer: FooterContent;
}

const { footer } = Astro.props;
---

<footer class="nb-footer">
  <div class="nb-inner nb-footer__inner">
    <img
      src="/logos/nb-symbol-silver.png"
      alt="NB"
      width="2048"
      height="1571"
      class="nb-footer__mark"
    />
    <span class="nb-footer__tagline">{footer.tagline}</span>
    <span class="nb-footer__email">{footer.email}</span>
  </div>
</footer>

<style>
  .nb-footer {
    border-top: var(--border-hairline-dark-subtle);
    padding: var(--space-6) var(--content-gutter);
    background: var(--nb-navy-950);
  }

  .nb-footer__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
  }

  .nb-footer__mark {
    height: 22px;
    width: auto;
    object-fit: contain;
    justify-self: start;
  }

  .nb-footer__tagline {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--nb-silver-700);
    text-align: center;
  }

  .nb-footer__email {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--nb-silver-700);
    justify-self: end;
  }
</style>
